{
    "name": "Karakept Development",
    "image": "mcr.microsoft.com/devcontainers/java:dev-21-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
        "ghcr.io/CASL0/devcontainer-features/android-sdk:1": {
            "installNdk": "true",
            "installCmake": "true"
        },
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts",
            "installYarnUsingApt": "false"
        },
        "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
            "packages": "curl,nano,vim,ninja-build,python3,libgtk-3-dev,libwebkit2gtk-4.1-dev,xvfb,mesa-utils,libxcursor1,libxrandr2,libxi6,libxxf86vm1,fonts-noto-color-emoji,flatpak,flatpak-builder,dbus-x11,elfutils,imagemagick,libnotify-dev"
        }
    },
    "remoteEnv": {
        "ANDROID_HOME": "/usr/local/android",
        "ANDROID_SDK_ROOT": "/usr/local/android",
        "ANDROID_NDK_ROOT": "/usr/local/android/ndk/26.1.10909125"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "fwcd.kotlin",
                "mathiasfrohlich.Kotlin",
                "vscjava.vscode-java-pack",
                "vscjava.vscode-gradle",
                "usernamehw.errorlens"
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postStartCommand": "sudo service dbus start 2>/dev/null || true",
    "runArgs": [
        "--privileged",
        "--name=karakept-devcontainer"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
        "source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=/tmp/wayland-0,type=bind",
        "source=${localEnv:XDG_RUNTIME_DIR}/bus,target=/tmp/host-dbus.sock,type=bind",
        "source=karakept-android-home,target=/home/vscode/.android,type=volume",
        "source=karakept-gemini-home,target=/home/vscode/.gemini,type=volume",
        "source=${localEnv:HOME}/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock,target=/tmp/ssh-agent.sock,type=bind",
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind"
    ],
    "containerEnv": {
        "DISPLAY": ":0",
        "XDG_RUNTIME_DIR": "/tmp",
        "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock",
        "DBUS_SESSION_BUS_ADDRESS": "unix:path=/tmp/host-dbus.sock"
    }
}